# Copy these into Netlify → Site configuration → Environment variables (or into a local .env.local file).

# The Google Sheet that feeds the website (prices, products, texts, contact details, menu PDF link).
# Share it as "Anyone with the link → Viewer", then paste its normal address here.
# Leave unset to use the menu that is built into the website.
SHEET_URL=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX/edit

# How often (in seconds) the website re-reads the sheet in the background. Default 300 (5 minutes), minimum 60.
# SHEET_REVALIDATE_SECONDS=300

# The public address of the website (used for search-engine links and share cards).
NEXT_PUBLIC_SITE_URL=https://your-domain.com
